# ===== Required in production =====
JWT_SECRET=change-me-to-a-64-char-random-string

# ===== Telegram Login Widget =====
# Create a bot via @BotFather, then run /setdomain and /setwebhook on it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ===== Google OAuth =====
# https://console.cloud.google.com → OAuth 2.0 Client ID (Web)
# Currently disabled. Set ENABLE_GOOGLE_AUTH=true and fill CLIENT_ID to enable.
GOOGLE_CLIENT_ID=
ENABLE_GOOGLE_AUTH=false

# ===== Apple Sign-In =====
# https://developer.apple.com → Services ID
# Currently disabled. Set ENABLE_APPLE_AUTH=true and fill CLIENT_ID to enable.
APPLE_CLIENT_ID=
ENABLE_APPLE_AUTH=false

# ===== Telegram =====
ENABLE_TELEGRAM_AUTH=true

# ===== Admin bootstrap =====
# Comma-separated @handles that become admins on first login.
ADMIN_HANDLES=@societykolyan

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173
